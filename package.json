{
  "name": "ralph-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Paul Nguyen <daonhan@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daonhan/ralph.git"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "test": "node --test scripts/runner-floating-ref.test.mjs scripts/release-please-config.test.mjs scripts/update-status-table.test.mjs scripts/registries-not-behind-git.test.mjs scripts/smoke-image.test.mjs scripts/check-changes.test.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "smoke:image": "node scripts/smoke-image.mjs",
    "publish-all": "pnpm -r publish --access public --no-git-checks",
    "prepare": "node scripts/install-hooks.mjs --if-available"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
